# Environment Variables Template
# Copy this file to .env and fill in the values

# =============================================================================
# LLM Configuration (Groq)
# =============================================================================
GROQ_API_KEY=gsk_your_api_key_here

# =============================================================================
# Supabase Configuration
# =============================================================================

# Supabase Project URL (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (secret, server-side only, bypasses RLS)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (for verifying tokens, from Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# Storage Bucket Name (must already exist in Supabase Storage)
SUPABASE_BUCKET_NAME=Rendered-videos

# =============================================================================
# Storage Configuration
# =============================================================================

# Temporary directory for video rendering (before upload to Supabase)
# Default: system temp directory + /manim_renders
# TEMP_VIDEO_DIR=/tmp/manim_renders

# =============================================================================
# Manim Configuration
# =============================================================================

# Manim render quality: low, medium, high
MANIM_QUALITY=low

# Manim render timeout (seconds)
MANIM_TIMEOUT=120

# =============================================================================
# API Configuration
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# =============================================================================
# Development/Production Mode
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# =============================================================================
# Optional: Analytics & Monitoring
# =============================================================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://...

# LogTail source token (for log aggregation)
# LOGTAIL_SOURCE_TOKEN=...
